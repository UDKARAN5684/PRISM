# Normalise to LF in the repository regardless of the OS the work was done on.
# Without this, a Windows checkout commits CRLF and every file looks modified to
# a collaborator on Linux (and to CI).
* text=auto eol=lf

# Binary: never touch these.
*.png   binary
*.jpg   binary
*.parquet binary
*.joblib  binary
*.duckdb  binary
*.ipynb text eol=lf
